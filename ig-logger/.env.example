# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
# Create an API key at My IG -> Settings -> API keys. Demo and live are
# SEPARATE keys on separate accounts; start on demo.

IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
IG_API_KEY=your_api_key

# DEMO or LIVE. Leave it on DEMO until the data looks right.
IG_ACC_TYPE=DEMO

# Required. The account id, e.g. ABC12. Not optional: trading_ig passes this
# straight to Lightstreamer as the username and never fills it in itself, so
# without it you authenticate as None and get no data.
IG_ACC_NUMBER=ABC12

# Comma-separated epics. Find them via the IG API search or the platform URL.
IG_EPICS=CS.D.EURUSD.MINI.IP,IX.D.FTSE.DAILY.IP

# Optional tuning - defaults shown
# IG_DATA_DIR=data
# IG_FLUSH_ROWS=5000
# IG_FLUSH_SECONDS=30
# IG_STALE_SECONDS=300
# IG_QUEUE_SIZE=200000
